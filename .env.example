# --- Supabase (Project Settings) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # nur serverseitig

# --- Postgres (Settings → Database → Connection string) ---------------------
# Laufzeit (Vercel Functions): Transaction-Pooler, Port 6543, ?pgbouncer=true
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations / drizzle-kit / studio: direkter Zugang, Port 5432
DATABASE_URL_DIRECT=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- SMTP Postausgang (Mailversand -> "Jetzt senden") ---------------------
# Strato: Host smtp.strato.de, Port 465, SSL/TLS. Werte NICHT einchecken.
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@example.com
SMTP_PASS=<smtp-passwort>
SMTP_FROM=Nik Huber Guitars <info@example.com>
